# Copy to .env (git-ignored) and change every value: cp .env.example .env

# PostgreSQL — superuser (init only) + one role per service
POSTGRES_USER=market_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=market
ORDERS_DB_PASSWORD=change-me-orders
INVENTORY_DB_PASSWORD=change-me-inventory
PAYMENTS_DB_PASSWORD=change-me-payments
AUTH_DB_PASSWORD=change-me-auth

# MongoDB
MONGO_INITDB_ROOT_USERNAME=market_admin
MONGO_INITDB_ROOT_PASSWORD=change-me

# MinIO (S3-compatible data lake)
MINIO_ROOT_USER=market_admin
MINIO_ROOT_PASSWORD=change-me-min8chars

# Grafana
GF_SECURITY_ADMIN_PASSWORD=change-me

# Auth — JWT signing key (generate with: openssl rand -hex 32)
JWT_SECRET=change-me
JWT_TTL_MINUTES=15
